{
    "name": "prestashopheaven/build-rules-code",
    "description": "Module-Factory rules for module code: structure, main class, install, database, PHP, docblocks, hooks, security, PrestaShop 8/9 compatibility, dependencies, packages and the DDD + CQRS architecture.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "George van Engers",
            "email": "vanengers@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "prestashopheaven/build-rules-core": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "PrestaShopHeaven\\Build\\RulesCode\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PrestaShopHeaven\\Build\\RulesCode\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "prestashopheaven": {
            "kind": "build",
            "use-when": "When code of a module is designed or written: the rules of STR, MOD, INS, DB, PHP, DOC, HK, SEC, CMP, DEP, PKG and ARCH.",
            "keywords": [
                "rules",
                "conventions",
                "php",
                "architecture",
                "ddd",
                "cqrs",
                "security",
                "hooks",
                "database"
            ]
        }
    }
}
