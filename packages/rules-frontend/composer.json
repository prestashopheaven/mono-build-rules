{
    "name": "prestashopheaven/build-rules-frontend",
    "description": "Module-Factory rules for what merchants and customers see: templates and assets, back office and Symfony, front controllers and multistore.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "George van Engers",
            "email": "vanengers@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "prestashopheaven/build-rules-core": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "PrestaShopHeaven\\Build\\RulesFrontend\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PrestaShopHeaven\\Build\\RulesFrontend\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "prestashopheaven": {
            "kind": "build",
            "use-when": "When templates, JavaScript, back-office pages, front controllers or multistore behaviour of a module are built: the rules of TPL, BO, FC and MS.",
            "keywords": [
                "rules",
                "conventions",
                "templates",
                "javascript",
                "backoffice",
                "frontoffice",
                "multistore"
            ]
        }
    }
}
