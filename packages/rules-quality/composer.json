{
    "name": "prestashopheaven/build-rules-quality",
    "description": "Module-Factory rules for quality: tests, tooling, tests on real PrestaShop shops and the internal test shop.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "George van Engers",
            "email": "vanengers@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "prestashopheaven/build-rules-core": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "PrestaShopHeaven\\Build\\RulesQuality\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PrestaShopHeaven\\Build\\RulesQuality\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "prestashopheaven": {
            "kind": "build",
            "use-when": "When tests are written or the definition of done runs: the rules of TST, TOOL, TEST and TS.",
            "keywords": [
                "rules",
                "conventions",
                "tests",
                "coverage",
                "docker",
                "test shop",
                "tooling"
            ]
        }
    }
}
